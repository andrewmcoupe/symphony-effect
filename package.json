{
  "name": "symphony-effect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,dashboard -c blue,magenta \"pnpm dev:server\" \"pnpm dev:dashboard\"",
    "dev:server": "pnpm --filter symphony dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1"
}
