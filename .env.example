# Symphony environment variables
#
# Copy this file to `.env` (which is gitignored) and fill in the values:
#
#   cp .env.example .env
#
# `pnpm dev` / `pnpm dev:server` auto-load this file (via tsx's
# --env-file-if-exists). The orchestrator substitutes `$VAR` references in
# WORKFLOW.md from these values, and lifecycle hooks inherit them.

# --- Required ---------------------------------------------------------------

# Linear API key. Used for the tracker GraphQL API and the Linear MCP server
# the agent uses to move issues and update acceptance criteria.
# Create one at: https://linear.app/settings/api
LINEAR_API_KEY=

# GitHub token used to open/reuse pull requests after an agent run.
# Needs `repo` scope (classic) or `pull_requests:write` + `contents:read` (fine-grained).
GITHUB_TOKEN=

# Repository the lifecycle hooks clone into each per-issue workspace
# (the `after_create` hook fails fast if this is unset).
# Use an authenticated form if the repo is private, e.g.
#   https://x-access-token:${GITHUB_TOKEN}@github.com/owner/name.git
SYMPHONY_REPOSITORY_URL=

# --- Optional ---------------------------------------------------------------

# Base branch the hooks branch from. Defaults to `main` when unset.
# SYMPHONY_BASE_BRANCH=main
